# ==============================================================================
# Neuron AI — Environment Configuration (.env.example)
#
# IMPORTANT SECURITY & DEPLOYMENT NOTICE:
# 1. DEVELOPER MODE:
#    Developers running from source can copy this file to .env and configure keys.
#    Local .env files are automatically read during development.
#    NEVER COMMIT OR PACKAGE REAL .env FILES.
#
# 2. INSTALLED USER MODE:
#    In production/packaged Windows distribution, .env is NOT required or bundled.
#    Neuron AI securely stores API keys in Windows Credential Manager:
#      - Target: NeuronAI/GeminiApiKey
#      - Target: NeuronAI/ElevenLabsApiKey
#    Non-secret user configuration (e.g. ElevenLabs Voice ID) is stored in:
#      - %LOCALAPPDATA%\NeuronAI\config.json
#    A first-run setup dialog appears automatically if credentials are missing.
#
# 3. BUNDLED SPEECH RECOGNITION (faster-whisper):
#    Packaged builds can bundle the local faster-whisper model under:
#      - models/faster-whisper-base.en/
#    If present, the bundled model is used 100% offline with zero network calls.
# ==============================================================================

# --- Multimodal LLM / Tutor Engine ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Speech-to-Text (STT) ---
STT_PROVIDER=whisper
WHISPER_MODEL=base.en

# --- Text-to-Speech (TTS) ---
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Wake Word & Hands-Free Activation ---
NEURON_WAKE_WORD_ENABLED=true
NEURON_WAKE_WORD_PHRASE="Hey Neuron"
NEURON_CAPTURE_DELAY_MS=80

# --- Execution & Demo Mode ---
# Modes:
#   auto     - Live Gemini first; seamless recovery with deterministic demo fallbacks on failure (Recommended for pitch)
#   live     - Direct cloud API only; errors propagate per Block 3 contract
#   fallback - 100% offline; deterministic prevalidated scenario responses with zero cloud API calls
NEURON_DEMO_MODE=auto

# --- Diagnostics & Observability ---
NEURON_METRICS_ENABLED=true
LOG_LEVEL=INFO
