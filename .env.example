# ==============================================================================
# Neuron AI — Environment Configuration (.env)
# Copy this file to .env and configure keys for your local environment.
# DO NOT COMMIT THE REAL .env FILE WITH SECRET KEYS TO VERSION CONTROL.
# ==============================================================================

# --- Block 3: Multimodal LLM / Tutor Engine ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Block 2: Speech-to-Text (STT) ---
STT_PROVIDER=whisper
WHISPER_MODEL=base.en

# --- Block 5: Text-to-Speech (TTS) ---
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Block 6: Wake Word & Activation ---
NEURON_WAKE_ENABLED=true
NEURON_CAPTURE_DELAY_MS=80

# --- Block 7: Execution & Demo Mode ---
# Modes:
#   auto     - Live Gemini first; seamless recovery with deterministic demo fallbacks on failure (Recommended for pitch)
#   live     - Direct cloud API only; errors propagate per Block 3 contract
#   fallback - 100% offline; deterministic prevalidated scenario responses with zero cloud API calls
NEURON_DEMO_MODE=auto

# --- Block 8: Diagnostics & Observability ---
NEURON_METRICS_ENABLED=true
NEURON_LOG_LEVEL=INFO
