# Neuron AI environment configuration
# Block 3: Multimodal LLM / Tutor Engine
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Block 2: Speech-to-Text (local offline faster-whisper default)
STT_PROVIDER=whisper
WHISPER_MODEL=base.en

# Block 5: Text-to-Speech (ElevenLabs)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
